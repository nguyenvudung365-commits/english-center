# R2 deployment: copy to .env ONLY if it does not exist; never commit real secrets.
# .NET khong tu doc .env, Compose se nap file nay. Khong dung mau nay cho MinIO.
# Dung chuoi hex/ngau nhien khong co dau ; cho password PostgreSQL.
POSTGRES_PASSWORD=
# It nhat 32 byte UTF-8; giu nguyen qua cac lan deploy.
JWT_SIGNING_KEY=
# Chi can khi bootstrap lan dau; sau do bo ca email va password.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=Administrator
BOOTSTRAP_ADMIN_PASSWORD=
API_PORT=5080
WEB_PORT=8088
# S3 API endpoint tu Cloudflare: HTTPS, khong kem /ten-bucket.
# Hai endpoint giong nhau; KHONG dung domain website, r2.dev hay custom domain.
MEDIA_STORAGE_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
MEDIA_STORAGE_PUBLIC_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
MEDIA_STORAGE_BUCKET=english-center-files
MEDIA_STORAGE_REGION=auto
# R2 Object Read & Write, chi bucket tren; dung Access Key ID / Secret Access Key,
# KHONG dung Token value. Giu bucket private; CORS cau hinh tren Cloudflare,
# khong phai bien Compose: origin frontend chinh xac, GET/PUT/HEAD,
# AllowedHeaders Content-Type, ExposeHeaders ETag. Khong sua URL sau khi ky.
MEDIA_STORAGE_ACCESS_KEY=
MEDIA_STORAGE_SECRET_KEY=
