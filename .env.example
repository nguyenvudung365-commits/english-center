# Dien gia tri that vao .env local; .NET khong tu doc .env, Compose se nap file nay.
# Dung chuoi hex/ngau nhien khong co dau ; cho password PostgreSQL.
POSTGRES_PASSWORD=
# It nhat 32 byte UTF-8; giu nguyen qua cac lan deploy.
JWT_SIGNING_KEY=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Chi can khi bootstrap lan dau; sau do bo ca email va password.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=Administrator
BOOTSTRAP_ADMIN_PASSWORD=
API_PORT=5080
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
