# Local/test ONLY: copy to .env.minio, use --env-file .env.minio -f compose.minio.yaml.
# Do not use deployment credentials/database. Fill blank secrets before starting.
POSTGRES_PASSWORD=
JWT_SIGNING_KEY=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=Administrator
BOOTSTRAP_ADMIN_PASSWORD=
API_PORT=5080
WEB_PORT=8088
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# Separate app user; NEVER reuse MinIO root credentials or an existing broad user.
MEDIA_STORAGE_ACCESS_KEY=
MEDIA_STORAGE_SECRET_KEY=
MEDIA_STORAGE_BUCKET=english-center-media
MEDIA_STORAGE_REGION=us-east-1
# Internal endpoint is fixed to http://minio:9000; browser endpoint follows MINIO_PORT.
MEDIA_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
MEDIA_STORAGE_CORS_ORIGINS=http://localhost:8088
